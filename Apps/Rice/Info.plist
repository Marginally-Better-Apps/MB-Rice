			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ricepack</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.marginallybetter.ricepack+zip</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
